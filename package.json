{
  "name": "sworddock-bible",
  "version": "0.1.14",
  "private": true,
  "description": "SwordDock Bible — theme-adaptive offline-first Bible study for Obsidian",
  "scripts": {
    "build": "node esbuild.config.mjs production && node scripts/build-community.mjs",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "library:build": "python3 scripts/build_web_library.py",
    "crossrefs:build": "python3 scripts/build_cross_references.py",
    "commentary:build": "python3 scripts/build_commentary.py",
    "tagged:build": "python3 scripts/build_tagged_bible.py",
    "interlinear:build": "python3 scripts/build_interlinear.py",
    "qa:interlinear": "node scripts/verify-interlinear.mjs",
    "qa:rich-resources": "node scripts/verify-rich-resources.mjs",
    "qa:commentary-content": "node scripts/verify-commentary-content.mjs",
    "deploy:test": "node scripts/deploy-test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "package:preview": "python3 scripts/build_preview.py",
    "smoke:preview": "python3 scripts/smoke_preview.py",
    "qa:mysword": "node scripts/verify_mysword_local.mjs",
    "qa:mysword:benchmark": "node --expose-gc scripts/benchmark_mysword_local.mjs",
    "package:community": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/sql.js": "^1.4.11",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "playwright-core": "1.65.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "node-html-parser": "7.0.1",
    "sql.js": "^1.16.0"
  },
  "license": "MIT"
}
